# ---------------------------------------------------------------------------
# Weather MCP Server — Streamable HTTP transport
#
# Copy to .env next to docker-compose.yml and fill in the Auth0 settings.
# Every variable from .env.example (units, ENABLED_TOOLS, optional API keys,
# cache tuning) works here too; only the HTTP-specific ones are listed below.
# ---------------------------------------------------------------------------

# REQUIRED. OAuth is the only HTTP authentication mode; incomplete settings
# make startup fail rather than falling back to a static key.
WEATHER_AUTH0_DOMAIN=your-tenant.us.auth0.com
WEATHER_AUTH0_AUDIENCE=https://weather.laputa.one/mcp
WEATHER_PUBLIC_BASE_URL=https://weather.laputa.one

# Garmin validates the same Weather token and resolves its sub through the
# active /connect users table. This URL is reachable only on mcp-internal.
WEATHER_GARMIN_AUTHZ_URL=http://garmin-api:8412/internal/weather/identity

# Optional exceptions that preserve legacy saved-location directory names.
WEATHER_TENANT_ALIASES_FILE=/config/tenant-aliases.json

# Listen address inside the container. Leave as-is when using Docker.
WEATHER_HTTP_HOST=0.0.0.0
WEATHER_HTTP_PORT=8080

# Base path of the OAuth-protected MCP endpoint. Clients connect to /mcp.
WEATHER_HTTP_PATH=/mcp

# Where saved locations are stored (one subdirectory per tenant id).
WEATHER_DATA_DIR=/data

# Per-tenant request budget, requests per minute. 0 disables rate limiting.
WEATHER_HTTP_RATE_LIMIT=120

# Maximum accepted JSON-RPC request body, in bytes.
WEATHER_HTTP_MAX_BODY_BYTES=1048576

# Answer with a single application/json body (true, default) instead of an SSE
# stream. Plain JSON survives buffering reverse proxies; set false only if you
# have configured the proxy for SSE and want streamed responses.
WEATHER_HTTP_JSON_RESPONSE=true

# DNS-rebinding protection. Set to the public hostname once the domain is live;
# leaving it empty disables the Host check (fine while testing over loopback).
# WEATHER_HTTP_ALLOWED_HOSTS=weather.laputa.one
# WEATHER_HTTP_ALLOWED_ORIGINS=https://claude.ai,https://chatgpt.com

# Expose the ChatGPT-compatible `search` / `fetch` tools alongside the native
# ones. Off by default — only ChatGPT's deep-research connector needs them.
WEATHER_CHATGPT_COMPAT=false

# The lightning tool holds a persistent MQTT connection. Keep the startup
# pre-warm off on a server: there are no saved locations at boot to pre-warm.
WEATHER_LIGHTNING_PREWARM=false

# Which tools to expose. "all" is everything; see src/config/tools.ts.
ENABLED_TOOLS=all

# Units for rendered output.
WEATHER_UNITS=metric

# 0=DEBUG 1=INFO 2=WARN 3=ERROR
LOG_LEVEL=1
